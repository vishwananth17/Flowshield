# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# FLOWSHIELD AI Express Backend Environment Template
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Hosting Mode (production, staging, development)
ENVIRONMENT=production
PORT=8000

# PostgreSQL database connection (e.g. from Supabase connection string)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_ID].supabase.co:5432/postgres

# Redis Cache connection (e.g. from Upstash or Railway)
REDIS_URL=redis://:[PASSWORD]@[HOST]:[PORT]

# Supabase Auth & Storage API access
SUPABASE_URL=https://[PROJECT_ID].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=[JWT_SECRET_FROM_SUPABASE_API_SETTINGS]

# Application-layer field encryption key (must be at least 32 characters)
DB_ENCRYPTION_KEY=[GENERATED_32_CHAR_SECURE_KEY]

# Razorpay Subscription Integration
RAZORPAY_KEY_ID=rzp_live_[KEY_ID]
RAZORPAY_KEY_SECRET=[KEY_SECRET]
RAZORPAY_WEBHOOK_SECRET=[YOUR_SECURE_WEBHOOK_SECRET_AT_LEAST_20_CHARS]

# Allowed CORS client origins (comma-separated if multiple)
CORS_ORIGINS=https://app.flowshieldai.com
LOG_LEVEL=info
